{
  "name": "dsh-mcp-manager",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server manager: a Host half that connects stdio/Streamable-HTTP MCP servers and registers their tools on ctx.tools, plus a browser settings page that edits, starts, and stops them through the profile's cordis.patch.yml.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/channel.js",
    "lib/client.js",
    "lib/naming.js",
    "lib/patch-file.js",
    "lib/supervisor.js",
    "test/*.mjs",
    "README.md"
  ],
  "license": "MIT"
}
